---
import type { CollectionEntry } from 'astro:content';

interface Props {
	settings: CollectionEntry<'settings'>['data'];
	currentPath?: string;
}

const { settings, currentPath = '/' } = Astro.props;
const [siteFirst, siteMid, siteLast] = settings.siteName.split('.');
const isHome = currentPath === '/';
const brandHref = isHome ? '#top' : '/';
---

<header class="jp-header">
	<div class="jp-header-inner">
		<a href={brandHref} class="jp-brand">
			<span class="jp-brand-mark">{settings.brandInitials}</span>
			<span class="jp-brand-name">
				{siteFirst}<span class="jp-dot">.</span>{siteMid}<span class="jp-dot">.</span>{siteLast}
			</span>
		</a>
		<button
			type="button"
			class="jp-nav-toggle"
			aria-controls="jp-menu"
			aria-expanded="false"
			aria-label="Menu"
		>
			<span class="jp-nav-toggle-bar"></span>
			<span class="jp-nav-toggle-bar"></span>
			<span class="jp-nav-toggle-bar"></span>
		</button>
		<nav id="jp-menu" class="jp-menu">
			{
				settings.nav.map((item) => {
					const isCta = item.href === settings.contactCta.href;
					const isActive = !isCta && item.href === currentPath;
					if (isCta) {
						return (
							<a href={item.href} class="jp-nav-cta">
								{item.label}
							</a>
						);
					}
					return (
						<a
							href={item.href}
							class:list={[
								'jp-nav-link',
								item.footerOnly && 'jp-nav-link--mobile',
								isActive && 'jp-nav-link--active',
							]}
							aria-current={isActive ? 'page' : undefined}
						>
							{item.label}
						</a>
					);
				})
			}
		</nav>
	</div>
</header>

<style>
	.jp-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(250, 248, 244, 0.88);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.jp-header-inner {
		position: relative;
		max-width: 1180px;
		margin: 0 auto;
		padding: 14px 20px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}

	.jp-brand {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: var(--text);
		cursor: pointer;
		/* Padding matches the nav links so the hover highlight has the same
		   shape/feel; the negative margin offsets it so the logo doesn't shift. */
		padding: 8px 12px;
		margin: -8px -12px;
		border-radius: 8px;
		transition:
			background 0.15s,
			color 0.15s;
	}

	.jp-brand:hover {
		background: var(--beige);
		color: var(--accent-deep);
	}

	.jp-brand:hover .jp-brand-mark {
		border-color: var(--accent-deep);
		color: var(--accent-deep);
	}

	.jp-brand-mark {
		width: 34px;
		height: 34px;
		border-radius: 9px;
		border: 1.5px solid var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent);
		font-family: var(--heading-font);
		font-size: 18px;
		flex-shrink: 0;
	}

	.jp-brand-name {
		font-weight: 600;
		letter-spacing: -0.01em;
		font-size: 16px;
	}

	.jp-dot {
		color: var(--muted);
	}

	.jp-menu {
		display: flex;
		align-items: center;
		gap: 4px;
		white-space: nowrap;
	}

	.jp-nav-link {
		text-decoration: none;
		color: var(--text);
		font-size: 14.5px;
		padding: 8px 12px;
		border-radius: 8px;
		transition:
			background 0.15s,
			color 0.15s;
	}

	.jp-nav-link:hover {
		background: var(--beige);
		color: var(--accent-deep);
	}

	.jp-nav-link--active {
		color: var(--accent-deep);
		font-weight: 600;
		background: var(--beige);
	}

	/* The "Main Page" (home) route lives in the footer on desktop; it only
	   surfaces inside the mobile dropdown so tapping home is obvious there. */
	.jp-nav-link--mobile {
		display: none;
	}

	.jp-nav-cta {
		text-decoration: none;
		color: #fff;
		background: var(--accent);
		font-size: 14.5px;
		font-weight: 600;
		padding: 8px 16px;
		border-radius: 99px;
		transition: background 0.15s;
	}

	.jp-nav-cta:hover {
		background: var(--accent-deep);
	}

	/* Hamburger toggle — hidden until the layout gets tight. */
	.jp-nav-toggle {
		display: none;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
		width: 42px;
		height: 42px;
		padding: 0;
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 11px;
		cursor: pointer;
		transition: background 0.15s;
	}

	.jp-nav-toggle:hover {
		background: var(--beige);
	}

	.jp-nav-toggle-bar {
		display: block;
		width: 20px;
		height: 2px;
		border-radius: 2px;
		background: var(--text);
		transition:
			transform 0.2s,
			opacity 0.2s;
	}

	.jp-nav-toggle[aria-expanded='true'] .jp-nav-toggle-bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.jp-nav-toggle[aria-expanded='true'] .jp-nav-toggle-bar:nth-child(2) {
		opacity: 0;
	}

	.jp-nav-toggle[aria-expanded='true'] .jp-nav-toggle-bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* Switch to the hamburger before the horizontal nav can outgrow the row.
	   The full desktop nav needs ~860px; below that it would overflow. */
	@media (max-width: 900px) {
		.jp-header-inner {
			padding: 11px 18px;
		}

		.jp-nav-toggle {
			display: flex;
		}

		/* Nav becomes a right-aligned dropdown under the compact header row. */
		.jp-menu {
			position: absolute;
			top: calc(100% + 8px);
			right: 12px;
			left: auto;
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 2px;
			min-width: 220px;
			max-width: calc(100vw - 24px);
			padding: 8px;
			background: var(--bg);
			border: 1px solid var(--border);
			border-radius: 16px;
			box-shadow: 0 14px 34px rgba(31, 41, 38, 0.14);
			white-space: normal;
		}

		.jp-menu.is-open {
			display: flex;
		}

		.jp-nav-link,
		.jp-nav-link--mobile {
			display: block;
			font-size: 15px;
			padding: 11px 14px;
		}

		.jp-nav-cta {
			margin-top: 4px;
			padding: 12px 16px;
			font-size: 15px;
			text-align: center;
		}
	}
</style>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.jp-nav-toggle');
	const menu = document.getElementById('jp-menu');

	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			menu.classList.toggle('is-open', open);
		};

		toggle.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		// Tapping any menu entry navigates, so collapse the panel behind it.
		menu.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		// Close when tapping anywhere outside the toggle or the panel.
		document.addEventListener('click', (event) => {
			const target = event.target as Node;
			if (!menu.contains(target) && !toggle.contains(target)) setOpen(false);
		});
	}
</script>
