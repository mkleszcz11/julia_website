---
import { getImage } from '../lib/images';

interface Props {
	src: string;
	alt: string;
	ratio: string;
	/** Rendered width of the slot, so the browser can pick a variant off the srcset. */
	sizes?: string;
	/** Only the above-the-fold photo on each page should be eager. */
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	position?: string;
	radius?: string;
	background?: string;
	borderColor?: string | false;
	shadow?: string;
	class?: string;
}

const {
	src,
	alt,
	ratio,
	sizes = '100vw',
	loading = 'lazy',
	fetchpriority = 'auto',
	position = '50% 50%',
	radius = '16px',
	background = 'var(--beige)',
	borderColor = 'var(--border)',
	shadow,
	class: className,
} = Astro.props;

// null for a photo that has no generated variants yet — render it as-is rather
// than 404-ing on a path the pipeline never saw.
const image = getImage(src);
---

<div
	class:list={['jp-cover', className]}
	style={{
		aspectRatio: ratio,
		borderRadius: radius,
		background,
		border: borderColor ? `1px solid ${borderColor}` : 'none',
		boxShadow: shadow,
	}}
>
	{
		image ? (
			<picture>
				{image.sources.map((source) => (
					<source type={source.type} srcset={source.srcset} sizes={sizes} />
				))}
				<img
					src={image.src}
					width={image.width}
					height={image.height}
					alt={alt}
					loading={loading}
					fetchpriority={fetchpriority}
					decoding="async"
					style={{ objectPosition: position }}
				/>
			</picture>
		) : (
			<img
				src={src}
				alt={alt}
				loading={loading}
				fetchpriority={fetchpriority}
				decoding="async"
				style={{ objectPosition: position }}
			/>
		)
	}
</div>

<style>
	.jp-cover {
		position: relative;
		overflow: hidden;
	}

	/* The <picture> is a layout no-op so the <img> keeps sizing against .jp-cover. */
	.jp-cover picture {
		display: contents;
	}

	.jp-cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
